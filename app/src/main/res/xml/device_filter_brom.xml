<?xml version="1.0" encoding="utf-8"?>
<!-- MediaTek VID 0x0E8D = 3725 desimal. Cuma VID yang dicocokkan (tanpa PID) supaya semua mode
     MediaTek — Preloader (0x2000), BROM (0x0003), dan varian chip baru — memicu "Buka dengan Senza Tools".
     Kalau pengguna mencentang "Gunakan sebagai default", izin USB otomatis diberikan saat device dicolok,
     jadi dialog izin yang memakan waktu (dan membuat jendela BROM yang singkat keburu lewat) tidak muncul. -->
<resources>
    <usb-device vendor-id="3725" />
</resources>
